[resource]
script = ExtResource("1_catalog")
friends = Array[ExtResource("2_friend")]([ExtResource("4_leon"), ExtResource("5_gonzalo"), ExtResource("6_agustin")])
nights = Array[ExtResource("3_night")]([ExtResource("7_night_1"), ExtResource("8_night_2"), ExtResource("9_night_3"), ExtResource("10_night_4"), ExtResource("11_night_5")])
decoys = Array[ExtResource("12_decoy")]([SubResource("Decoy_cold_breath"), SubResource("Decoy_distant_dog"), SubResource("Decoy_flickering_light"), SubResource("Decoy_wet_grass"), SubResource("Decoy_trunk_moss"), SubResource("Decoy_creaking_branches"), SubResource("Decoy_hanging_laundry"), SubResource("Decoy_barbed_fence"), SubResource("Decoy_lapping_water"), SubResource("Decoy_creaking_door"), SubResource("Decoy_dripping_water"), SubResource("Decoy_dog_prints"), SubResource("Decoy_smoke_smell")])
tutorial = ExtResource("15_night_0")
incidents = Array[ExtResource("16_incident")]([SubResource("Incident_cut"), SubResource("Incident_ankle"), SubResource("Incident_soaked"), SubResource("Incident_bump"), SubResource("Incident_thorn")])
greeting_keys = Array[String](["FIRST_CALL_1", "FIRST_CALL_2", "FIRST_CALL_3", "FIRST_CALL_4", "FIRST_CALL_5", "FIRST_CALL_6"])
balance = ExtResource("13_balance")
phone_posts = Array[ExtResource("14_post")]([SubResource("PhonePost_01"), SubResource("PhonePost_02"), SubResource("PhonePost_03"), SubResource("PhonePost_04"), SubResource("PhonePost_05"), SubResource("PhonePost_06"), SubResource("PhonePost_07"), SubResource("PhonePost_08"), SubResource("PhonePost_09"), SubResource("PhonePost_10"), SubResource("PhonePost_11"), SubResource("PhonePost_12")])
phone_disturbing_posts = Array[ExtResource("14_post")]([SubResource("PhoneDisturbing_1"), SubResource("PhoneDisturbing_2"), SubResource("PhoneDisturbing_3"), SubResource("PhoneDisturbing_4")])
