[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/chat_entry.gd" id="entry_script"]
[ext_resource type="SpriteFrames" path="res://art/sprites/entry_sprite.aseprite" id="entry_frames"]
[ext_resource type="FontFile" path="res://fonts/departure_mono/DepartureMono-Regular.otf" id="font"]

[node name="ChatEntry" type="Node2D"]
script = ExtResource("entry_script")

[node name="Background" type="AnimatedSprite2D" parent="."]
sprite_frames = ExtResource("entry_frames")
animation = &"idle"
centered = false

[node name="NameLabel" type="Label" parent="."]
offset_left = 6.0
offset_top = 3.0
offset_right = 94.0
offset_bottom = 23.0
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 11
text = "AMIGO"

[node name="Signal" type="HBoxContainer" parent="."]
offset_left = 98.0
offset_top = 7.0
offset_right = 117.0
offset_bottom = 19.0
mouse_filter = 2
theme_override_constants/separation = 1

[node name="Health" type="HBoxContainer" parent="."]
offset_left = 124.0
offset_top = 8.0
offset_right = 150.0
offset_bottom = 18.0
mouse_filter = 2
theme_override_constants/separation = 3

[node name="TimerLabel" type="Label" parent="."]
offset_left = 150.0
offset_top = 3.0
offset_right = 236.0
offset_bottom = 23.0
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 11
horizontal_alignment = 2
