[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="pause_script"]
[ext_resource type="Theme" path="res://scenes/ui/menu_theme.tres" id="menu_theme"]
[ext_resource type="Script" path="res://scripts/ui/framed_box.gd" id="framed_box"]
[ext_resource type="PackedScene" path="res://scenes/ui/options_panel.tscn" id="options_panel"]

[node name="PauseMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("menu_theme")
script = ExtResource("pause_script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.012, 0.024, 0.043, 0.85)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Box" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
script = ExtResource("framed_box")
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 33
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="Options" type="Button" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="SkipTutorial" type="Button" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="Menu" type="Button" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="OptionsPanel" parent="." instance=ExtResource("options_panel")]
layout_mode = 1
